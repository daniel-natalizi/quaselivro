source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins
gem "jekyll-include-cache", group: :jekyll_plugins

# Melhorias recomendadas:
gem "jekyll-sitemap"           # SEO: gera sitemap.xml
gem "jekyll-feed"              # RSS: feed para leitores
gem "jekyll-seo-tag"           # Otimização SEO automática
gem "jemoji"                   # Suporte a emojis
gem "kramdown-parser-gfm"      # Markdown GitHub-flavored melhorado
